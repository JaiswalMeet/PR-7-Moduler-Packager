import datetime
import math
import random
import uuid

while True:
    print("==================================================")
    print("Welcome to Multi-Utility Toolkit")
    print("==================================================")
    print("Choose an option:")
    print("1. DateTime and Time Operations")
    print("2. Mathematical Operations")
    print("3. Random Data Generation")
    print("4. Generate Unique Identifiers (UUID)")
    print("5. File Operations (Custom Module)")
    print("6. Explore Module Attributes (dir())")
    print("7. Exit")
    
    choice = input("Enter your choice: ")
    
    if choice == '1':
        while True:
            print("--------------------------------------------------")
            print("DateTime and Time Operations:")
            print("1. Display current date and time")
            print("2. Calculate difference between two dates/times")
            print("3. Format date into custom format")
            print("4. Stopwatch")
            print("5. Countdown timer")
            print("6. Back to Main Menu")
            d_choice = input("Enter your choice: ")
            
            if d_choice == '1':
                now = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
                print(f"Current date and time: {now}")
            elif d_choice == '2':
                d1 = input("Enter the first date (YYYY-MM-DD): ")
                d2 = input("Enter the second date (YYYY-MM-DD): ")
                date1 = datetime.datetime.strptime(d1, "%Y-%m-%d")
                date2 = datetime.datetime.strptime(d2, "%Y-%m-%d")
                diff = abs((date2 - date1).days)
                print(f"Difference: {diff} days")
            elif d_choice == '6':
                break
                
    elif choice == '2':
        while True:
            print("--------------------------------------------------")
            print("Mathematical Operations:")
            print("1. Calculate Factorial")
            print("2. Solve Compound Interest")
            print("3. Trigonometric Calculations")
            print("4. Area of Geometric Shapes")
            print("5. Back to Main Menu")
            m_choice = input("Enter your choice: ")
            
            if m_choice == '1':
                num = int(input("Enter a number: "))
                print(f"Factorial: {math.factorial(num)}")
            elif m_choice == '2':
                p = float(input("Enter principal amount: "))
                r = float(input("Enter rate of interest (in %): "))
                t = float(input("Enter time (in years): "))
                ci = p * math.pow((1 + r / 100), t) - p
                print(f"Compound Interest: {ci}")
            elif m_choice == '5':
                break

    elif choice == '3':
        while True:
            print("--------------------------------------------------")
            print("Random Data Generation:")
            print("1. Generate Random Number")
            print("2. Generate Random PIN")
            print("3. Create Random Password")
            print("4. Generate Random OTP")
            print("5. Back to Main Menu")
            r_choice = input("Enter your choice: ")
            
            if r_choice == '3':
                length = int(input("Enter password length: "))
                chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*"
                pwd = "".join(random.choice(chars) for _ in range(length))
                print(f"Generated Password: {pwd}")
            elif r_choice == '5':
                break

    elif choice == '4':
        print("--------------------------------------------------")
        print("Generate Unique Identifiers (UUID):")
        print(f"Generated UUID: {uuid.uuid4()}")
        print("--------------------------------------------------")
        
    elif choice == '5':
        while True:
            print("--------------------------------------------------")
            print("File Operations (Custom Module):")
            print("1. Create & Write a File")
            print("2. Read from a File")
            print("3. Append to a File")
            print("4. Back to Main Menu")
            f_choice = input("Enter your choice: ")
            
            if f_choice == '1':
                fname = input("Enter file name (example.txt): ")
                content = input("Enter text to write: ")
                with open(fname, "w") as f:
                    f.write(content)
                print(f"File '{fname}' created successfully!")
            elif f_choice == '2':
                fname = input("Enter file name to read: ")
                try:
                    with open(fname, "r") as f:
                        print(f"--- {fname} ---")
                        print(f.read())
                except:
                    print("File not found.")
            elif f_choice == '4':
                break

    elif choice == '6':
        print("--------------------------------------------------")
        print("Explore Module Attributes (dir()):")
        mod = input("Enter module name to explore (math, datetime, random): ")
        if mod == "math":
            print(f"Available attributes in math module:\n{dir(math)}")
        elif mod == "datetime":
            print(f"Available attributes in datetime module:\n{dir(datetime)}")
        elif mod == "random":
            print(f"Available attributes in random module:\n{dir(random)}")
        print("--------------------------------------------------")
        
    elif choice == '7':
        print("==================================================")
        print("Exit:")
        print("==================================================")
        print("Thank you for using the Multi-Utility Toolkit!")
        break